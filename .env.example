# Neon Postgres (free) — สร้างที่ https://neon.tech แล้ว copy connection string มาวาง
# ใช้ "Pooled connection" สำหรับ DATABASE_URL และ "Direct connection" สำหรับ DIRECT_URL
# ถ้ามีอันเดียว ใส่ค่าเดียวกันทั้งสองได้

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
