generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// ผู้สมัครเข้าโครงการ (Round 1 = phone screening, Round 2 = zoom interview)
model Candidate {
  id        String  @id @default(cuid())
  seq       Int? // เลขลำดับ # จาก CSV เดิม
  score     Int? // คะแนนที่ให้มาก่อนแล้ว
  name      String
  phone     String?
  company   String?
  province  String?
  position  String? // ตำแหน่ง เช่น เจ้าของบริษัท
  income    String? // รายได้ เช่น 1-2M, 300-500K
  channels  String[] // ช่องทาง FB / TikTok / Web / LINE
  age       Int?
  reason    String? // เหตุผลที่เขียนมา

  facebookUrl String? // ลิงก์เพจ Facebook (ถ้าเป็น URL)
  website     String? // ลิงก์เว็บไซต์ (ถ้าเป็น URL)

  // ----- สถานะการคัดกรอง Round 1 (โทรสัมภาษณ์) -----
  contactStatus   ContactStatus @default(PENDING) // ติดต่อได้/ไม่ได้
  hasNotebook     Boolean       @default(false) // (จำเป็น) มี notebook สำหรับเข้าอบรม
  availableLaunch Boolean       @default(false) // ว่างมาพิธีเปิด 11 มิ.ย. 09:00 (Zoom 2 ชม.)
  trainingGroups  Int[]         @default([]) // กลุ่มเทรนนิ่งที่เข้าได้: 1 = ทุกพุธ, 2 = ทุกจันทร์ (เลือกได้หลายกลุ่ม)
  visitAvailable  Boolean       @default(false) // สะดวกให้นัด visit กิจการครั้งแรก (12-23 มิ.ย.) — ค่อยนัดวันจริงทีหลัง
  consultDate     DateTime?     @db.Date // วันนัด visit จริง (กำหนดทีหลัง)
  iindustryReg    Boolean       @default(false) // ลงทะเบียน i-industry ก่อน 23 มิ.ย.

  // ----- การจองช่องสัมภาษณ์ -----
  interviewSlotId String?        @unique
  interviewSlot   InterviewSlot? @relation(fields: [interviewSlotId], references: [id], onDelete: SetNull)

  // ----- ผลคัด -----
  result       Result  @default(PENDING) // ผลคัด Round 1
  failReason   String? // เหตุผลที่ "ไม่ผ่าน" (กรอกตอนกดไม่ผ่าน)
  round2Result Result  @default(PENDING) // ผลคัด Round 3 (สัมภาษณ์ Zoom): PASS = ได้เข้าร่วม (15 คน)
  notes        String?

  // ----- คะแนนสัมภาษณ์ Round 3 (Matrix) -----
  itvGate1a Boolean? // มาพิธีเปิด 11 มิ.ย.
  itvGate1b Boolean? // group sessions x4
  itvGate1c Boolean? // on-site x5
  itvGate1d Boolean? // i-industry ก่อน 23 มิ.ย.
  itvScore2 Int? // จำเป็นเว็บ/AI (1-5)
  itvScore3 Int? // สินค้าชัด
  itvScore4 Int? // ประสบการณ์ออนไลน์
  itvScore5 Int? // ความตั้งใจ
  itvScore6 Int? // ต้นทุนเดิม
  itvScore7 Int? // ทักษะ digital
  itvNotes  String? // โน้ตจากการสัมภาษณ์

  // ----- จัดกลุ่มจริง + นัด visit (เฉพาะผู้ผ่าน Final) -----
  finalGroup    Int? // กลุ่มเรียนจริงที่จัดให้: 1 = พุธ, 2 = จันทร์
  visitCoach    String? // โค้ชที่ไป 1st visit (อ.แอม / อ.มิ้น / อ.เอ็ม)
  visitLocation String? // สถานที่นัด visit (ถ้าต่างจากที่อยู่บริษัท)
  // i-industry จริง = ใช้ field iindustryReg เดิม
  // วันนัด 1st visit จริง = ใช้ field consultDate เดิม (@db.Date)

  // ----- รายงานวินิจฉัยรายกิจการ (1st visit / consult) -----
  visitReport VisitReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([result])
  @@index([contactStatus])
}

/// ช่องเวลาสัมภาษณ์ Online 4-5 มิ.ย. (รวม 30 ช่อง, 15 ช่อง/วัน)
model InterviewSlot {
  id        String     @id @default(cuid())
  day       DateTime   @db.Date // 2026-06-04 (พฤ) / 2026-06-05 (ศ)
  slotNo    Int // ลำดับช่องในวัน 1..15
  label     String // บ.#1 ... บ.#30
  startTime String // "09:00"
  endTime   String // "09:15"
  candidate Candidate?

  @@unique([day, slotNo])
  @@index([day])
}

/// ผู้สมัครทั้งหมด (raw จาก lead.csv) — เก็บครบทุกช่องสำหรับ export
model Lead {
  id            String  @id @default(cuid())
  seq           Int? // ลำดับแถวจากไฟล์
  submittedAt   String? // ส่งเมื่อ
  prefix        String? // คำนำหน้าชื่อ
  firstName     String? // ชื่อ
  lastName      String? // นามสกุล
  idCard        String? // เลขบัตรประชาชน
  birthDate     String? // วันเกิด
  phone         String? // หมายเลขโทรศัพท์มือถือ (ตามไฟล์)
  phoneNorm     String? // เบอร์ปกติ 0xxx (ใช้ match กับ candidate)
  email         String?
  address       String? // ที่อยู่
  company       String? // ชื่อธุรกิจ/บริษัท
  registrationNo String? // เลขทะเบียนนิติบุคคล/พาณิชย์
  companyAddress String? // ที่อยู่บริษัท
  area          String? // เขตพื้นที่/จังหวัด
  businessType  String? // ประเภทธุรกิจ
  mainProduct   String? // สินค้า/บริการหลัก
  businessAbout String? // ทำธุรกิจเกี่ยวกับ
  channels      String? // ช่องทางจำหน่าย (ดิบ)
  position      String? // ตำแหน่ง
  department    String? // แผนก
  revenue       String? // รายได้บริษัทต่อปี
  businessSize  String? // ขนาดกิจการ
  yearsOperating String? // ระยะเวลาดำเนินธุรกิจ
  websiteReason String? // ทำไมธุรกิจต้องมีเว็บ
  facebookUrl   String? // เพจ Facebook
  website       String? // เว็บไซต์
  consent       String? // การยินยอม
  productImage  String? // ลิงก์ภาพถ่ายผลิตภัณฑ์/บริการ

  createdAt DateTime @default(now())

  @@index([phoneNorm])
}

/// รายงานวินิจฉัยรายกิจการ ตอนลงพื้นที่ 1st visit (1:1 กับ Candidate)
/// เก็บเฉพาะ "เนื้อหาวินิจฉัย" — ข้อมูลพื้นฐานกิจการดึงจาก Candidate/Lead
model VisitReport {
  id          String    @id @default(cuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // ----- ส่วนที่ 1 ข้อมูลเพิ่มเติม (ที่ Candidate/Lead ยังไม่มี) -----
  capitalRegistered String? // ทุนจดทะเบียน
  yearRegistered    String? // ปีที่จดทะเบียนธุรกิจ
  currentEcommerce  String? // ช่องทาง e-Commerce ปัจจุบัน (สรุป)
  history           String? @db.Text // 1.2 ประวัติความเป็นมา

  // ----- ส่วนที่ 2 วินิจฉัย -----
  swotStrength    String? @db.Text
  swotWeakness    String? @db.Text
  swotOpportunity String? @db.Text
  swotThreat      String? @db.Text
  channelAnalysis Json    @default("[]") // [{ channel, status, recommend }]

  // ----- ส่วนที่ 3 ปัญหา -----
  problems     String? @db.Text // 3.1 ปัญหาหลัก
  improvements String? @db.Text // 3.2 สิ่งที่อยากพัฒนา

  // ----- ส่วนที่ 4 แนวทางพัฒนา -----
  approach   String? @db.Text // 4.1 แนวทาง/วิธีการ
  mandayPlan Json    @default("[]") // [{ activity, planned: bool }]

  // ----- ส่วนที่ 5 เว็บไซต์ที่เหมาะสม -----
  websiteComponents Json    @default("[]") // [{ component, suitable: bool, note }]
  domainWanted      String?
  assets            Json    @default("{}") // { logo, productImages, ... } : bool

  // ----- ภาคผนวก / KPI baseline -----
  mouSigned        Boolean @default(false)
  consentSigned    Boolean @default(false)
  mandaySigned     Boolean @default(false)
  kpiSalesPerMonth String?
  kpiCustomers     String?
  kpiMainChannel   String?
  oldWebsiteUrl    String?

  // ----- รูป/วิดีโอ (checklist เตือน — ไฟล์จริงเก็บนอกระบบ) -----
  photos   String[] @default([]) // ลิงก์/ชื่อไฟล์ภาพ (สินค้า/บริการ/ร้าน/ทีม)
  videoUrl String?

  status    VisitStatus @default(DRAFT) // DRAFT / DONE
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum VisitStatus {
  DRAFT
  DONE
}

enum ContactStatus {
  PENDING // ยังไม่ได้โทร
  CONTACTED // ติดต่อได้
  UNREACHABLE // ติดต่อไม่ได้
}

enum Result {
  PENDING // ยังไม่ตัดสิน
  PASS // ผ่าน
  FAIL // ไม่ผ่าน
}
